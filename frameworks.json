{
  "frameworks": [
    {
      "id": "aiken",
      "label": "Aiken",
      "kind": "onchain",
      "discoveryPath": "onchain/aiken/aiken.toml",
      "statusPrefix": "aiken",
      "build": "aiken",
      "repo": "https://github.com/aiken-lang/aiken"
    },
    {
      "id": "ccl-java",
      "label": "CCL Java",
      "kind": "offchain",
      "discoveryPath": "offchain/ccl-java/*.java",
      "statusPrefix": "ccl",
      "subdir": "offchain/ccl-java",
      "entryGlob": "*.java",
      "runtime": "jbang",
      "versionFile": "offchain/ccl-java/*.java",
      "packages": [
        "cardano-client-lib"
      ],
      "repo": "https://github.com/bloxbean/cardano-client-lib"
    },
    {
      "id": "meshjs",
      "label": "Mesh.js",
      "kind": "offchain",
      "discoveryPath": "offchain/meshjs/deno.json",
      "statusPrefix": "mesh",
      "subdir": "offchain/meshjs",
      "entryGlob": "*.ts",
      "runtime": "deno",
      "versionFile": "offchain/meshjs/deno.json",
      "packages": [
        "@meshsdk/core",
        "@meshsdk/core-csl",
        "@meshsdk/common"
      ],
      "repo": "https://github.com/MeshJS/mesh"
    },
    {
      "id": "evolutionsdk",
      "label": "Evolution SDK",
      "kind": "offchain",
      "discoveryPath": "offchain/evolutionsdk/deno.json",
      "statusPrefix": "evosdk",
      "subdir": "offchain/evolutionsdk",
      "entryGlob": "*.ts",
      "runtime": "deno",
      "versionFile": "offchain/evolutionsdk/deno.json",
      "packages": [
        "@evolution-sdk/lucid"
      ],
      "repo": "https://github.com/no-witness-labs/evolution-sdk"
    },
    {
      "id": "pycardano",
      "label": "PyCardano",
      "kind": "offchain",
      "discoveryPath": "offchain/pycardano/requirements.txt",
      "statusPrefix": "pycardano",
      "subdir": "offchain/pycardano",
      "entryGlob": "*.py",
      "runtime": "python",
      "versionFile": "offchain/pycardano/requirements.txt",
      "packages": [
        "pycardano"
      ],
      "repo": "https://github.com/Python-Cardano/pycardano"
    },
    {
      "id": "julc-java",
      "label": "JulC + CCL (Java)",
      "kind": "fullstack",
      "discoveryPath": "fullstack/java/settings.gradle",
      "statusPrefix": "julc",
      "subdir": "fullstack/java",
      "runtime": "gradle",
      "versionFile": "fullstack/java/app/build.gradle",
      "packages": [
        "cardano-client-lib",
        "julc"
      ],
      "verify": "build+run",
      "repo": "https://github.com/bloxbean/julc"
    },
    {
      "id": "scalus-fullstack",
      "label": "Scalus",
      "kind": "fullstack",
      "discoveryPath": "fullstack/scalus/build.sbt",
      "statusPrefix": "scalusfs",
      "subdir": "fullstack/scalus",
      "runtime": "sbt",
      "versionFile": "fullstack/scalus/build.sbt",
      "packages": [
        "scalus"
      ],
      "verify": "build",
      "repo": "https://github.com/scalus3/scalus"
    }
  ]
}
